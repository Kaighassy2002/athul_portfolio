{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://athul-portfolio-server.onrender.com/sitemap.xml"
    },
    {
      "source": "/api/:path*",
      "destination": "https://athul-portfolio-server.onrender.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
